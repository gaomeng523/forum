<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.devcircle</groupId>
    <artifactId>dev-circle</artifactId>
    <version>1.0.0</version>
    <name>dev-circle</name>
    <description>DevCircle 计算机专业技术社区</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- 第三方依赖版本统一在这里管理，升级时只改一处 -->
        <mybatis-plus.version>3.5.5</mybatis-plus.version>
        <jjwt.version>0.12.3</jjwt.version>
        <lombok.version>1.18.30</lombok.version>
    </properties>

    <dependencies>
        <!-- ==================== Web / 模板 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- 注意：Boot 4 里这个 artifactId 改名为 spring-boot-starter-webmvc，
                 本项目锁定 Boot 3.2.5，所以用 spring-boot-starter-web -->
        </dependency>

        <!-- Thymeleaf 服务端渲染。刻意不引入 SPA 框架（见 ADR-001） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- 表单参数校验：@Valid / @NotBlank / @Size … -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- AOP：限流切面 RateLimitAspect、日志切面 LogAspect 靠它
             （Boot 4 里改名为 spring-boot-starter-aspectj） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- ==================== 实时通信 ==================== -->
        <!-- 原生 WebSocket Handler（不用 STOMP，见 ADR-005） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ==================== 持久层 ==================== -->
        <!--
            注意 artifactId 是 mybatis-plus-spring-boot3-starter，
            不是老的 mybatis-plus-boot-starter —— Spring Boot 3 必须用这个，
            用错了会在启动时报 "factoryBeanObjectType" 相关的类型转换异常。
            分页插件 PaginationInnerInterceptor 需要的 jsqlparser 由本依赖
            传递带入（实测为 4.6），不需要再单独声明。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>

        <!-- MySQL 驱动。版本由 Boot 3.2.5 管理（8.3.0），无需手写 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 缓存 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Lettuce 连接池依赖，不加这个 spring.data.redis.lettuce.pool.* 配置会失效 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 安全 ==================== -->
        <!--
            只引 spring-security-crypto 这一个 jar 拿 BCryptPasswordEncoder，
            不引 spring-boot-starter-security。
            理由：本项目权限模型只有三级（游客/用户/管理员），
            JWT 拦截器 + @RequireLogin / @RequireAdmin 注解就够了（见 ADR-004），
            引入完整 Security 会带来一整套用不上的过滤器链和默认登录页。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- JWT：三个 jar 分工见下方说明 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <!-- jjwt-impl 只在运行期需要，编译期由 api 提供接口 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- 让 JJWT 用 Jackson 序列化 payload；换成别的 JSON 库要换这个 jar -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 开发效率 ==================== -->
        <!--
            Lombok 用 @Data / @Slf4j 等注解省掉样板代码。
            前提：IDEA 需装 Lombok 插件并开启注解处理（File → Settings →
            Build → Compiler → Annotation Processors → Enable）。
            不想用可以整体删掉，不影响其它依赖。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <!-- Boot 3 的测试 starter。Boot 4 把它拆成了 spring-boot-starter-webmvc-test
             等按模块划分的多个 starter，本项目锁定 3.2.5 所以用这个 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期起作用，不打进最终 jar -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
